public class configurazione
    implements Runnable {

  public String indirizzoWS;
  public int portaWS = 23;
  public String userWS;
  public String passwWS;
  public String comandi =
      "conf t\n" +
      "end\n";
  public ArrayList addressWSs = new ArrayList();
  public String addressWSs(int i) {
    return (String) addressWSs.get(i);
  }

  public ArrayList userWSs = new ArrayList();
  public String userWSs(int i) {
    return (String) userWSs.get(i);
  }

  public ArrayList passWSs = new ArrayList();
  public String passWSs(int i) {
    return (String) passWSs.get(i);
  }

  public String promptWS = null;
  public String[][] utentiParoleLogIN;
  public String[] paroleLogIN;
  public String[] paroleEnable;
  public String[] user_name_Enable;
  public String[] user_passwd_Enable;
  public String fileIndirizzi;
  public String fileIndirizziVisitati;
  public String fileIndirizziFalliti;
  public String directoryShRun;
  public String directoryShTech;
  public String directoryVinaccia;
  public String directoryShLogging;
  public String start_discovery_address;
  public boolean first_discovery = true;
  public String directoryBase;

  public configurazione(int numeroLogin, int numeroEnable,
                        int numeroParoleLogIN, int numero_user_name_passwd) {
    utentiParoleLogIN = new String[numeroLogin][2];
    paroleEnable = new String[numeroEnable];
    paroleLogIN = new String[numeroParoleLogIN];
    user_name_Enable = new String[numero_user_name_passwd];
    user_passwd_Enable = new String[numero_user_name_passwd];
  }

  public void run() {
    File cartellaShRun = new File(directoryShRun);
    cartellaShRun.mkdir();
    File cartellaShTech = new File(directoryShTech);
    cartellaShTech.mkdir();
    File cartellaVinaccia = new File(directoryVinaccia);
    cartellaVinaccia.mkdir();
    File cartellaShLogging = new File(directoryShLogging);
    cartellaShLogging.mkdir();
  }
}