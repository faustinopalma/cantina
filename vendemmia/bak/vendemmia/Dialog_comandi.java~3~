public class Dialog_comandi extends JDialog {
  JPanel panel1 = new JPanel();
  BorderLayout borderLayout1 = new BorderLayout();
  JPanel jPanel1 = new JPanel();
  JButton jButton1 = new JButton();
  JScrollPane jScrollPane1 = new JScrollPane();
  JEditorPane jEditorPane1 = new JEditorPane();
  configurazione conf;

  public Dialog_comandi(Frame frame, String title, boolean modal, configurazione conf) {
    super(frame, title, modal);
    try {
      jbInit();
      pack();
    }
    catch(Exception ex) {
      ex.printStackTrace();
    }
    this.conf=conf;
  }

  public Dialog_comandi(configurazione conf) {
    this(null, "", false, conf);
  }
  private void jbInit() throws Exception {
    panel1.setLayout(borderLayout1);
    jButton1.setText("jButton1");
    jEditorPane1.setText(conf.comandi);
    getContentPane().add(panel1);
    panel1.add(jPanel1, BorderLayout.SOUTH);
    jPanel1.add(jButton1, null);
    panel1.add(jScrollPane1, BorderLayout.CENTER);
    jScrollPane1.getViewport().add(jEditorPane1, null);
  }
}