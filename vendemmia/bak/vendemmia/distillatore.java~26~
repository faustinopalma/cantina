  public String[] separaRighe() {
    try {
      ArrayList risultato = new ArrayList();
      int prima = 0;
      int ultima = 0;
      String testoNew = "\n"+testo+"\n";
      boolean uscire = false;
      while (!uscire) {
        ultima = testoNew.indexOf("\n", ultima+1);
        if (ultima!=-1) {
          if (ultima-prima==1) {
            risultato.add("");
          } else {
            risultato.add(testo.substring(prima, ultima-1) );
          }
          prima = ultima;
        } else {
          uscire = true;
        }
      }//end while
      if (risultato.size() > 0) {
        Object[] r = risultato.toArray();
        String[] rString = new String[r.length];
        for (int k = 0; k < r.length; k++) {
          rString[k] = (String) r[k];
        }
        return rString;
      } else {
        return null;
      }
    } catch (NullPointerException e) {return null;}
  }

