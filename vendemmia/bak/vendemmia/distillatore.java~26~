  public String prendiUltimaRigaOld() {
    String delimitatori = "\n";
    int lunghezza = testo.length();
    int i = lunghezza - 1;
    boolean delimitatoreTrovato = false;
    while ( (i >= 0) & !delimitatoreTrovato) {
      boolean accapo;
      accapo = delimitatori.indexOf(testo.substring(i, i+1) ) != -1;
      if (accapo ) {
        delimitatoreTrovato = true;
      }
      i--;
    }
    return testo.substring(i+1, lunghezza);
  } // fine prendiUltimaRigaBobina

  public String prendiUltimaRiga() {
