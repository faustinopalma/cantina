  private void comando(String comando) throws IOException {
//---------------- esegue il comando -----------------------------------------
    tok.board.append("\n" + comando);
    memo.marcaInizioComando = tok.reg.bobina.length();
    tok.reg.scrivi(comando + "\n");
    tok.reg.aspettaCaratteriTempo(3, 10000);
    String prompt_responce_sh_neigh = waitPrompt(300, prompt_router);
    if (prompt_responce_sh_neigh.compareTo("Prompt") != 0) {
      tok.board.append("\n Attesa troppo lunga per la risposta del router!!!\n");
    }
    memo.marcaFineComando = tok.reg.bobina.length();
    tok.board.append("    ---> terminato");
  }

