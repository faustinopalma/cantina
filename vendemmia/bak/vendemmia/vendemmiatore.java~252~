      if (next_step.compareTo("open_telnet") == 0) {
        //tok.board.append("\ntelnet<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        if (user_pass_all_tried && pass_all_tried) {
          return "login_passwords_incorrect";
        }

        try {
          tok.reg.scrivi("telnet " + address + "\n");
        }
        catch (IOException err) {}
        tok.reg.aspettaCaratteriTempo(1, 1000);
        prompt_responce = waitPrompt(100, tok.conf.promptWS);
        if (prompt_responce.compareTo("void") == 0) {
          next_step = "handle_void";
        }
        else if (prompt_responce.compareTo("UserName") == 0) {
          next_step = "digit_user_name";
        }
        else if (prompt_responce.compareTo("UserPassword") == 0) {
          next_step = "digit_password";
        }
        else if (prompt_responce.compareTo("Prompt") == 0) {
          return "telnet_failed";
        }
        //------------------------------------------------------------------------
      }
      else if (next_step.compareTo("digit_user_name") == 0) {
        //tok.board.append("\ndigit_user_name<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        if (user_pass_all_tried) {
          return "login_passwords_incorrect";
