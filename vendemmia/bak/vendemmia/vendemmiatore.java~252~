          return "telnet_successfull";
        }
        else if (prompt_responce.compareTo("Prompt") == 0) {
          next_step = "open_telnet";
        }
        //------------------------------------------------------------------------
      }
      else if (next_step.compareTo("digit_password") == 0) {
        //tok.board.append("\ndigit_password<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        if (pass_all_tried) {
