  private void wait_token() {
    while (!tok.ready) {
      try {
        Thread.currentThread().sleep(100);
      }
      catch (InterruptedException err) {
        System.err.println(err);
      }
    } // end while (!tok.ready)
  }

  private String promptInterpreter(String prompt) {
    String bobinaCompleta = tok.reg.bobina.toString();
    distillatore distillaBobinaCompleta = new distillatore(bobinaCompleta);
    String ultimaRiga = distillaBobinaCompleta.prendiUltimaRiga();
    Pattern userPattern = Pattern.compile(
        "([Uu][Ss][Ee][Rr])|([Ll][Oo][Gg][Ii][Nn])");
    Pattern passPattern = Pattern.compile("[Pp][Aa][Ss][Ss]");
    Matcher userMatcher = userPattern.matcher(ultimaRiga);
    Matcher passMatcher = passPattern.matcher(ultimaRiga);
    boolean userBool = userMatcher.find();
    boolean passBool = passMatcher.find();
    int lungBobina = tok.reg.bobina.toString().length();
    boolean promptBool = false;
    try {
      promptBool = prompt.compareTo(tok.reg.bobina.toString().
                                    substring(lungBobina - prompt.length(),
                                              lungBobina)) == 0;
    }
    catch (StringIndexOutOfBoundsException err) {
      System.out.println(err);
    }
    if (userBool & !passBool) {
      return "UserName";
    }
    if (passBool) {
      return "UserPassword";
    }
    if (promptBool) {
      return "Prompt";
    }
    return "void";
  } //end private String promptInterpreter()

  String waitPrompt(int how_long, String prompt) {
    boolean go_ahead = false;
    boolean too_long = false;
    int times = 0;
    String returnCode = "void";
    while (!go_ahead && !too_long) {
      returnCode = promptInterpreter(prompt);
      go_ahead = returnCode.compareTo("void") != 0;
      if (!go_ahead) {
        tok.reg.aspettiamo(1000);
      }
      times++;
      too_long = times > how_long;
      if (too_long) {
        tok.reg.aspettiamo(3000);
      }
    } //end while (!go_ahead && !too_long)
    return returnCode;
  } //end waitPrompt()

  String wait_prompt_complete() {
    String returnCode;
    int times = 0;
    while (true) {
      returnCode = waitPrompt(5, tok.conf.promptWS);
      if (times > 6) {
        return returnCode;
      }
      else if (returnCode.compareTo("void") == 0) {
        if (verify_router()) {
          return "prompt_router";
        }
      }
      else {
        return returnCode;
      }
      times++;
    } // end while(true)
  } //end String wait_prompt_complete()

  String wait_prompt_enabled(String prompt_dis, String prompt_ena) {
    String returnCode;
    int times = 0;
    while (true) {
      returnCode = waitPrompt(3, prompt_dis);
      if (times > 6) {
        return returnCode;
      }
      else if (returnCode.compareTo("void") == 0) {
        returnCode = promptInterpreter(prompt_ena);
        if (returnCode.compareTo("Prompt") == 0) {
          return "enabled";
        }
      }
      else {
        return returnCode;
      }
      times++;
    } // end while(true)
  } //end String wait_prompt_complete()

  String open_telnet(String address) {
