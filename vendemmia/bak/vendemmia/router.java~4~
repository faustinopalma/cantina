public class router {
  public String id_name=null;
  public String id_address=null;
  public ArrayList neighbors = new ArrayList();
  public neighbor neighbor(int i) {return (neighbor) neighbors.get(i);}

  public ArrayList interfaces = new ArrayList();
  public class interf {
    public String type;
    public ArrayList addresses = new ArrayList();
    public String address(int i) {return (String) addresses.get(i);}
  }
  public interf interf(int i) {return (interf) interfaces.get(i);}
}