  router add_router_to_DB() {
    router new_router = new router();
    try {
      tok.reg.scrivi("terminal length 0\n");
    } catch (IOException err) {}
    //--------------------------------------------------------------------------
    int sh_eigrp_neighbor_start;
    int sh_eigrp_neighbor_end;
    sh_eigrp_neighbor_start=tok.reg.bobina.length();
    try {
      tok.reg.scrivi("show ip eigrp neighbors"+"\n");
    } catch (IOException err) {}
    tok.reg.aspettaCaratteriTempo(1,1000);
    String prompt_responce_sh_neigh= waitPrompt(30, prompt_router);
    sh_eigrp_neighbor_end=tok.reg.bobina.length();
    String sh_eigrp_neighbor=tok.reg.bobina.substring(sh_eigrp_neighbor_start,sh_eigrp_neighbor_end);
    distillatore distilla_sh_eigrp_neighbor = new distillatore(sh_eigrp_neighbor);
    String[] neighbors_addresses=distilla_sh_eigrp_neighbor.trovaPrendiRegularExp("[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}");
    neighbor new_neighbor;
    for (int i=0; i<neighbors_addresses.length; i++) {
      new_neighbor = new neighbor();
      new_neighbor.next_hop_address= neighbors_addresses[i];
      new_neighbor.next_hop_address_decimal= network.convert_IP2decimal(neighbors_addresses[i]);
      new_router.neighbors.add(new_neighbor);
    }
    //--------------------------------------------------------------------------
    int sh_interface_start;
    int sh_interface_end;
    sh_interface_start=tok.reg.bobina.length();
    try {
      tok.reg.scrivi("show ip interface brief"+"\n");
    } catch (IOException err) {}
    tok.reg.aspettaCaratteriTempo(1,1000);
    String prompt_responce_sh_int= waitPrompt(30, prompt_router);
    sh_interface_end=tok.reg.bobina.length();
    String sh_interface=tok.reg.bobina.substring(sh_interface_start,sh_interface_end);
    distillatore distilla_sh_interface = new distillatore(sh_interface);
    String[] ip_interfaces=distilla_sh_interface.trovaPrendiRegularExp("\n *[\\p{Alpha}\\p{Digit}\\p{Punct}]* *[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}");
    String[] ip_interfaces_addresses = new String[ip_interfaces.length];
    String[] ip_interfaces_types = new String[ip_interfaces.length];
    long address_decimal;
    long max_address_decimal=0;
    boolean loopback_on=false;
    for (int j=0; j<ip_interfaces.length; j++){
      ip_interface new_ip_interface = new ip_interface();
      new_ip_interface.type=ip_interfaces[j].substring(1, ip_interfaces[j].indexOf(32,1));
      new_ip_interface.address_primary=ip_interfaces[j].substring(ip_interfaces[j].lastIndexOf(32)+1);
      address_decimal=network.convert_IP2decimal(new_ip_interface.address_primary);
      new_ip_interface.address_primary_decimal=address_decimal;
      //....................
      if (new_ip_interface.type.indexOf("Loopback")>=0) {
        if (!loopback_on) {
          loopback_on = true;
          max_address_decimal=address_decimal;
        }
        if (max_address_decimal<address_decimal) max_address_decimal=address_decimal;
      }
      if (max_address_decimal<address_decimal && !loopback_on) max_address_decimal=address_decimal;
      new_router.interfaces.add(new_ip_interface);
    }
    //--------------------------------------------------------------------------
    new_router.id_name= prompt_router;
    String id_address=network.convert_decimal2IP(max_address_decimal);
    new_router.id_address=id_address;
    network.routers.add(new_router);
    return new_router;
  }

