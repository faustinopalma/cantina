  public boolean verify_router() {
    char prompt_delimiter= tok.reg.bobina.charAt(tok.reg.bobina.length()-1);
    if (prompt_delimiter!='>' && prompt_delimiter!='#') return false;
    try {
      //tok.reg.aspettiamo();//--- questa attesa si può eliminare ---
      int segnaLibro = tok.reg.bobina.length() -1;
      if (segnaLibro < 0) {segnaLibro = 0;}

      tok.reg.scrivi("?" + "\n");
      tok.reg.domande.flush();
      tok.reg.aspettaCaratteriTempo(1,1000);

      String aiuto = tok.reg.bobina.substring(segnaLibro);
      Pattern aiutoPattern = Pattern.compile("Exec commands:");
      Matcher aiutoMatcher = aiutoPattern.matcher(aiuto);
      if (aiutoMatcher.find() ) {
        tok.reg.scrivi("\3");//invio codice ^Z
        return true;
      } else {
        return false;
      }
    } catch (IOException e) {
      tok.board.append("\n" +"Errore IO nel metodo verify_router");
      return false;
    }
  }//end verify_router()

