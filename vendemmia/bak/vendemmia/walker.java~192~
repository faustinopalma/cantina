  private void wait_token() {
    while (!tok.ready) {
      try {
        Thread.currentThread().sleep(100);
      } catch (InterruptedException err) {
        System.err.println(err);
      }
    }// end while (!tok.ready)
  }

  private String promptInterpreter(String prompt) {
    String bobinaCompleta = tok.reg.bobina.toString();
    distillatore distillaBobinaCompleta = new distillatore(bobinaCompleta );
    String ultimaRiga = distillaBobinaCompleta.prendiUltimaRiga();
    Pattern userPattern = Pattern.compile("([Uu][Ss][Ee][Rr])|([Ll][Oo][Gg][Ii][Nn])");
    Pattern passPattern = Pattern.compile("[Pp][Aa][Ss][Ss]");
    Matcher userMatcher = userPattern.matcher(ultimaRiga );
    Matcher passMatcher = passPattern.matcher(ultimaRiga );
    boolean userBool = userMatcher.find();
    boolean passBool = passMatcher.find();
    int lungBobina = tok.reg.bobina.toString().length();
    boolean promptBool = prompt.compareTo(tok.reg.bobina.toString().
                  substring(lungBobina-prompt.length(), lungBobina))==0;
    if (userBool & !passBool ) {
      return "UserName";
    }
    if (passBool ) {
      return "UserPassword";
    }
    if (promptBool ) {
      return "Prompt";
    }
    return "void";
  } //end private String promptInterpreter()


  String waitPrompt(int how_long, String prompt) {
    boolean go_ahead=false;
    boolean too_long=false;
    int times=0;
    String returnCode="void";
    while (!go_ahead && !too_long) {
      returnCode=promptInterpreter(prompt);
      go_ahead=returnCode.compareTo("void")!=0;
      if (!go_ahead) {
        try {
          Thread.currentThread().sleep(1000);
        } catch (InterruptedException e) {}
      }
      times++;
      too_long= times>how_long;
    }//end while (!go_ahead && !too_long)
    return returnCode;
  }//end waitPrompt()


  String wait_prompt_complete() {
    String returnCode;
    int times=0;
    while (true) {
      returnCode= waitPrompt(5, tok.conf.promptWS);
      if (times>6) {
        return returnCode;
      } else if (returnCode.compareTo("void")==0) {
        if (verify_router()) return "prompt_router";
      } else {
        return returnCode;
      }
      times++;
    }// end while(true)
  }//end String wait_prompt_complete()

  String wait_prompt_enabled(String prompt_dis, String prompt_ena) {
    String returnCode;
    int times=0;
    while (true) {
      returnCode= waitPrompt(3, prompt_dis);
      if (times>6) {
        return returnCode;
      } else if (returnCode.compareTo("void")==0) {
        returnCode= promptInterpreter(prompt_ena);
        if (returnCode.compareTo("Prompt")==0) return "enabled";
      } else {
        return returnCode;
      }
      times++;
    }// end while(true)
  }//end String wait_prompt_complete()

  String open_telnet(String address) {
    int user_pass_tried=0;
    boolean user_pass_all_tried;
    int pass_tried=0;
    boolean pass_all_tried;
    String next_step="open_telnet";
    String prompt_responce;
    while (true) {
      user_pass_all_tried= !(user_pass_tried<tok.conf.utentiParoleLogIN.length);
      pass_all_tried= !(pass_tried<tok.conf.paroleLogIN.length);
      //------------------------------------------------------------------------
      if ( next_step.compareTo("open_telnet")==0 ) {
        //System.out.println("telnet<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        //tok.board.append("\ntelnet<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        if (user_pass_all_tried && pass_all_tried) return "login_passwords_incorrect";
        try {
          tok.reg.scrivi("\n");
          Thread.currentThread().sleep(100);
          tok.reg.scrivi("telnet "+address+"\n");
        } catch (IOException err) {
          System.err.println(err);
        } catch (InterruptedException err) {
          System.err.println(err);
        }
        tok.reg.aspettaCaratteriTempo(1,1000);
        prompt_responce= waitPrompt(30, tok.conf.promptWS);
        //System.out.println(prompt_responce);
        if (prompt_responce.compareTo("void")==0) {
          next_step="handle_void";
        } else if (prompt_responce.compareTo("UserName")==0) {
          next_step= "digit_user_name";
        } else if (prompt_responce.compareTo("UserPassword")==0) {
          next_step= "digit_password";
        } else if (prompt_responce.compareTo("Prompt")==0) {
          return "telnet_failed";
        }
      //------------------------------------------------------------------------
      } else if ( next_step.compareTo("digit_user_name")==0 ) {
        //tok.board.append("\ndigit_user_name<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        //System.out.println("digit_user_name<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        if (user_pass_all_tried) return "login_passwords_incorrect";
        try {
          tok.reg.scrivi(tok.conf.utentiParoleLogIN[user_pass_tried][0]+"\n");
        } catch (IOException err) {}
        tok.reg.aspettaCaratteriTempo(1,1000);
        prompt_responce= waitPrompt(30, tok.conf.promptWS);
        if (prompt_responce.compareTo("void")==0) {
          next_step="handle_void";
        } else if (prompt_responce.compareTo("UserName")==0) {
          next_step= "digit_user_name";
        } else if (prompt_responce.compareTo("UserPassword")==0) {
          next_step= "digit_user_passwd";
        } else if (prompt_responce.compareTo("Prompt")==0) {
          next_step= "open_telnet";
        }
      //------------------------------------------------------------------------
      } else if ( next_step.compareTo("digit_user_passwd")==0 ) {
        //tok.board.append("\ndigit_user_passwd<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        //System.out.println("digit_user_passwd<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        if (user_pass_all_tried) return "login_passwords_incorrect";
        try {
          tok.reg.scrivi(tok.conf.utentiParoleLogIN[user_pass_tried][1]+"\n");
        } catch (IOException err) {}
        user_pass_tried++;
        tok.reg.aspettaCaratteriTempo(1,1000);
        prompt_responce= wait_prompt_complete();
        if (prompt_responce.compareTo("void")==0) {
          next_step="handle_void";
        } else if (prompt_responce.compareTo("UserName")==0) {
          next_step= "digit_user_name";
        } else if (prompt_responce.compareTo("UserPassword")==0) {
          next_step= "digit_password";
        } else if (prompt_responce.compareTo("prompt_router")==0) {
          return "telnet_successfull";
        } else if (prompt_responce.compareTo("Prompt")==0) {
          next_step= "open_telnet";
        }
      //------------------------------------------------------------------------
      } else if ( next_step.compareTo("digit_password")==0 ) {
        //tok.board.append("\ndigit_password<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
        //System.out.println("digit_password<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<");
