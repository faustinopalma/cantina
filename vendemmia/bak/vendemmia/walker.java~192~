  boolean is_in_DB(neighbor neighbor_tested) {
    long next_add = network.convert_IP2decimal(neighbor_tested.next_hop_address);
    int i=0;
    boolean result=false;
    while (!result && i<network.routers.size()) {
      int j=0;
      while (!result && j<network.router(i).interfaces.size()) {
        if (network.router(i).ip_interface(j).address_primary_decimal==next_add) {
          result=true;
        }
        j++;
      }
      i++;
    }
    return result;
  }

