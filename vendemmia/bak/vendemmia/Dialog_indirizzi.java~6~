public class Dialog_indirizzi extends JDialog {
  JPanel panel1 = new JPanel();
  BorderLayout borderLayout1 = new BorderLayout();
  JPanel jPanel1 = new JPanel();
  JdbNavToolBar jdbNavToolBar1 = new JdbNavToolBar();
  JdbStatusLabel jdbStatusLabel1 = new JdbStatusLabel();
  TableScrollPane tableScrollPane1 = new TableScrollPane();
  JdbTable jdbTable1 = new JdbTable();
  JButton jButton1 = new JButton();
  TableDataSet tableDataSet1 = new TableDataSet();
  Column column1 = new Column();

  public Dialog_indirizzi(Frame frame, String title, boolean modal) {
    super(frame, title, modal);
    try {
      jbInit();
      pack();
    }
    catch(Exception ex) {
      ex.printStackTrace();
    }
  }

  public Dialog_indirizzi() {
    this(null, "", false);
  }
  private void jbInit() throws Exception {
    panel1.setLayout(borderLayout1);
    jdbStatusLabel1.setText("Stato");
    jButton1.setText("OK");
    jdbTable1.setDataSet(tableDataSet1);
    tableDataSet1.setMaxDesignRows(50);
    tableDataSet1.setResolvable(true);
    column1.setColumnName("Indirizzi");
    column1.setDataType(com.borland.dx.dataset.Variant.STRING);
    column1.setPreferredOrdinal(0);
    column1.setServerColumnName("NewColumn1");
    column1.setSqlType(0);
    tableDataSet1.setColumns(new Column[] {column1});
    getContentPane().add(panel1);
    panel1.add(jPanel1, BorderLayout.EAST);
    jPanel1.add(jButton1, null);
    panel1.add(jdbNavToolBar1, BorderLayout.NORTH);
    panel1.add(jdbStatusLabel1, BorderLayout.SOUTH);
    panel1.add(tableScrollPane1, BorderLayout.CENTER);
    tableScrollPane1.getViewport().add(jdbTable1, null);
  }
}