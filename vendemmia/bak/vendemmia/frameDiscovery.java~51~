public class frameDiscovery extends JFrame {
  JPanel contentPane;
  TextArea messaggi = new TextArea();
  BorderLayout borderLayout1 = new BorderLayout();
  //variabili da passare al vendemmiatore
  tokenDispencer dispencer;
  configurazione conf;
  Checkbox checkbox_visualizza = new Checkbox();
  Panel panel1 = new Panel();
  TextField textField_comando = new TextField();
  Button button_invio = new Button();
  BoxLayout2 boxLayout21 = new BoxLayout2();
  token new_token;
  network network;
  Button button_bobina = new Button();

  //Construct the frame
  public frameDiscovery(tokenDispencer dispencer, configurazione conf, network network) {
    this.dispencer = dispencer;
    this.conf = conf;
    this.network= network;
    enableEvents(AWTEvent.WINDOW_EVENT_MASK);
    try {
      jbInit();
    }
    catch(Exception e) {
      e.printStackTrace();
    }
  }
  //Component initialization
  private void jbInit() throws Exception  {
    //setIconImage(Toolkit.getDefaultToolkit().createImage(interfaccia.class.getResource("[Your Icon]")));
    contentPane = (JPanel) this.getContentPane();
    contentPane.setLayout(borderLayout1);
    this.setSize(new Dimension(460, 430));
    this.setTitle("Discovery");
    checkbox_visualizza.setLabel("visualizza");
    checkbox_visualizza.setState(true);
    checkbox_visualizza.addMouseListener(new java.awt.event.MouseAdapter() {
      public void mousePressed(MouseEvent e) {
        checkbox_visualizza_mousePressed(e);
      }
    });
    panel1.setLayout(boxLayout21);
    button_invio.setLabel("invio");
    button_invio.addMouseListener(new java.awt.event.MouseAdapter() {
      public void mousePressed(MouseEvent e) {
        button_invio_mousePressed(e);
      }
    });
    textField_comando.setColumns(30);
    button_bobina.setLabel("bobina");
    button_bobina.addMouseListener(new java.awt.event.MouseAdapter() {
      public void mousePressed(MouseEvent e) {
        button_bobina_mousePressed(e);
      }
    });
    panel1.add(checkbox_visualizza, null);
    panel1.add(textField_comando, null);
    panel1.add(button_invio, null);
    panel1.add(button_bobina, null);
    contentPane.add(messaggi, BorderLayout.CENTER);
    contentPane.add(panel1, BorderLayout.SOUTH);
    dispencer.addToken(messaggi, checkbox_visualizza);
    if (conf.first_discovery) {
      new_token = dispencer.takeToken();
      neighbor start_neighbor = new neighbor();
      start_neighbor.next_hop_address =conf.start_discovery_address;
      walker walker = new walker(new_token, network, start_neighbor, this);
      conf.first_discovery= false;
    } else {
      new_token = dispencer.takeToken();
      dispencer.returnToken(new_token);
    }
  }
  //Overridden so we can exit when window is closed
  protected void processWindowEvent(WindowEvent e) {
    super.processWindowEvent(e);
    if (e.getID() == WindowEvent.WINDOW_CLOSING) {
      //System.exit(0);
      new_token.destroy = true;
    }
  }

  void checkbox_visualizza_mousePressed(MouseEvent e) {

  }

  void button_invio_mousePressed(MouseEvent e) {
    try {
      new_token.reg.scrivi(textField_comando.getText()+"\n");
    } catch (IOException err) {}
    textField_comando.setText("");
  }

  void button_bobina_mousePressed(MouseEvent e) {
    printer printer = new printer();
  }
  public class printer  implements Runnable{
    public printer() {
      Thread thread = new Thread(this);
      thread.start();
    }
    public void run() {
      try {
        BufferedWriter escribe = new BufferedWriter(new FileWriter(conf.directoryBase+"\\bobina.txt"));
        escribe.write(new_token.reg.bobina.toString());
        escribe.flush();
        escribe.close();
      } catch (IOException err) {
        System.err.println(err);
      }
    }
  }


}