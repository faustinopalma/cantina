public class add_WS extends JDialog {
  JPanel panel1 = new JPanel();
  JTextField jTextField_address = new JTextField();
  JTextField jTextField_user = new JTextField();
  JLabel jLabel_address = new JLabel();
  JLabel jLabel_user = new JLabel();
  JButton jButton1 = new JButton();
  JTextField jTextField_password = new JTextField();
  JLabel jLabel_password = new JLabel();
  GridBagLayout gridBagLayout1 = new GridBagLayout();

  public add_WS(Frame frame, String title, boolean modal) {
    super(frame, title, modal);
    try {
      jbInit();
      pack();
    }
    catch(Exception ex) {
      ex.printStackTrace();
    }
  }

  public add_WS() {
    this(null, "", false);
  }
  private void jbInit() throws Exception {
    panel1.setLayout(gridBagLayout1);
    jLabel_address.setText("indirizzo");
    jLabel_user.setText("username");
    jButton1.setText("OK");
    jTextField_password.addActionListener(new add_WS_jTextField_password_actionAdapter(this));
    jLabel_password.setText("password");
    panel1.add(jTextField_address,     new GridBagConstraints(1, 0, 1, 1, 5.0, 1.0
            ,GridBagConstraints.CENTER, GridBagConstraints.HORIZONTAL, new Insets(5, 5, 5, 5), 0, 0));
    panel1.add(jTextField_user,     new GridBagConstraints(1, 1, 1, 1, 5.0, 1.0
            ,GridBagConstraints.CENTER, GridBagConstraints.HORIZONTAL, new Insets(5, 5, 5, 5), 0, 0));
    panel1.add(jLabel_user,   new GridBagConstraints(0, 1, 1, 1, 1.0, 1.0
            ,GridBagConstraints.CENTER, GridBagConstraints.HORIZONTAL, new Insets(5, 5, 5, 5), 0, 0));
    panel1.add(jLabel_address,   new GridBagConstraints(0, 0, 1, 1, 1.0, 1.0
            ,GridBagConstraints.CENTER, GridBagConstraints.HORIZONTAL, new Insets(5, 5, 5, 5), 0, 0));
    panel1.add(jButton1,    new GridBagConstraints(0, 3, 2, 1, 0.0, 0.0
            ,GridBagConstraints.CENTER, GridBagConstraints.NONE, new Insets(10, 10, 10, 10), 0, 0));
    panel1.add(jTextField_password,     new GridBagConstraints(1, 2, 1, 1, 5.0, 1.0
            ,GridBagConstraints.CENTER, GridBagConstraints.HORIZONTAL, new Insets(5, 5, 5, 5), 0, 0));
    panel1.add(jLabel_password,   new GridBagConstraints(0, 2, 1, 1, 1.0, 1.0
            ,GridBagConstraints.CENTER, GridBagConstraints.HORIZONTAL, new Insets(5, 5, 5, 5), 0, 0));
    this.getContentPane().add(panel1, BorderLayout.CENTER);
  }

  void jTextField_password_actionPerformed(ActionEvent e) {

  }
}

class add_WS_jTextField_password_actionAdapter implements java.awt.event.ActionListener {
  add_WS adaptee;

  add_WS_jTextField_password_actionAdapter(add_WS adaptee) {
    this.adaptee = adaptee;
  }
  public void actionPerformed(ActionEvent e) {
    adaptee.jTextField_password_actionPerformed(e);
  }
}