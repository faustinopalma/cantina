public class elenco {
  TextArea messaggi = new TextArea();
  public ArrayList lista = new ArrayList();
  public elenco(String arg , TextArea messaggi) {
    try {
      File radice = new File(arg);
      File[] elenco1 = radice.listFiles();

      for (int i = 0; i < elenco1.length; i++) {
        if (elenco1[i].isDirectory()) {
          elenco sottoCartella = new elenco(elenco1[i].getCanonicalPath(), messaggi);
          lista.addAll(sottoCartella.getLista());
        } else {
          lista.add(elenco1[i].getCanonicalPath());
        }
      }
    } catch (NullPointerException e) {
      messaggi.append("Classe elenco, Metodo elenco: Directory non trovata");
      throw IOException;
    } catch (IOException e) {
      messaggi.append("\n" + "Classe elenco, Metodo elenco: Problema nel sistema IO");
    }
  }
  public String getElemento(int i) {
    return (String) lista.get(i);
  }
  public ArrayList getLista() {
    return lista;
  }
  public int getLunghezza() {
    return (int) lista.size();
  }
} //Fine elenco