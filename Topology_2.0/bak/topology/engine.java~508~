  double forceR(int i, int j) {
    return -2*graph.k_repulsive*Math.exp(-Math.pow((graph.node(i).centrality-graph.node(j).centrality)/graph.r, 2))/
                  (graph.node(i).centrality+graph.node(j).centrality)*
                  (graph.node(i).n_centrality+graph.node(j).n_centrality)/4/Math.PI*(graph.node(i).angle-graph.node(j).angle)*
                  Math.exp(-Math.pow((graph.node(i).n_centrality+graph.node(j).n_centrality)/4/Math.PI*(graph.node(i).angle-graph.node(j).angle),2));
  }

  double energyR(int i, int j) {
    return graph.k_repulsive*Math.exp(-Math.pow((graph.node(i).centrality-graph.node(j).centrality)/graph.r, 2))/
                  (graph.node(i).centrality+graph.node(j).centrality)*
                  Math.exp(-Math.pow((graph.node(i).n_centrality+graph.node(j).n_centrality)/4/Math.PI*(graph.node(i).angle-graph.node(j).angle),2));
  }

  double forceA(int i, int j) {
    return -graph.k_attratctive/graph.node(i).vector(j).distance*(graph.node(i).angle-graph.node(j).angle);
  }

  double energyA(int i, int j) {
    return graph.k_attratctive/2/graph.node(i).vector(j).distance*Math.pow(graph.node(i).angle-graph.node(j).angle, 2);
  }

  double energy() {
    double energy=0;
    for (int i=0; i<graph.numNodes(); i++) {
      for (int j=0; j<i; j++) {
        energy+=energyA(i,j)+energyR(i,j);
      }
    }
    return energy;
  }

  double force(int i) {
    double force = 0;
    for (int j=0; j<graph.numNodes(); j++) {
      if (i!=j) force+= forceA(i,j)+forceR(i,j);
    }
    return force;
  }

  void move(double d, double g) {
    for (int i=0; i<graph.numNodes(); i++) {
      graph.node(i).lastDelta=graph.node(i).delta;
      graph.node(i).delta=d*force(i)-g*graph.node(i).lastDelta;
    }
    for (int i=0; i<graph.numNodes(); i++) {
      graph.node(i).angle+=graph.node(i).delta;
    }
  }

  void minimizza() {
    while (minimizza) {
      move(graph.delta, 0);
      interfaccia.label_Energia.setText(""+energy());
    }
  }

