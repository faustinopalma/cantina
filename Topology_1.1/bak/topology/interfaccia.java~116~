  void button_generaSVG_mousePressed(MouseEvent e) {
    lanciaOutputter outputter = new lanciaOutputter();
  }
  public class lanciaOutputter  implements Runnable{
    public lanciaOutputter() {
      Thread thread = new Thread(this);
      thread.start();
    }
    public void run() {
      outputterSVG out = new outputterSVG(engine.graph, nomeFileTopologiaXML.substring(0, nomeFileTopologiaXML.lastIndexOf("\\"))+"\\grezzo.svg");
      out.drawPolar((new Double(scaleR.getText())).doubleValue() );
    }
  }

  void button_incrementa_K_Gaussiana_mousePressed(MouseEvent e) {
    engine.Kgaussian+=(new Integer( textField_incremento_K_gaussiana.getText() )).intValue();
    label_KappaGaussiana.setText(""+engine.Kgaussian);
    label_KappaGaussiana.repaint();
  }

  void button_decrementa_K_Gaussiana_mousePressed(MouseEvent e) {
