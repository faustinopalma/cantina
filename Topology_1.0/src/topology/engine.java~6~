  double energy(Graph graph) {
    double energy=0;
    for (int i=0; i<graph.numLinks(); i++) {
      int s=graph.link(i).source;
      int t=graph.link(i).target;
      int ps=graph.node(s).getPosition();
      int pt=graph.node(t).getPosition();
      double distance = graph.link(i).distance;
      energy+=1/distance*Math.pow(graph.distance(ps, pt), 2);
//      energy+=Math.pow(graph.distance(ps, pt), 2);
    }
    return energy;
  }//end long energy

  long force(int id, Graph graph) {
    long force=0;
    int p=graph.node(id).getPosition();
    for (int i=0; i<graph.node(id).Neighbors.size(); i++) {
      int r=graph.node(id).neighbor(i);
      force+=graph.distance(r, p);
    }
    return force;
  }

  void evaluateForce(Graph graph) {
    for (int i=0; i<graph.numNodes(); i++) {
      graph.node(i).force=force(i, graph);
    }
  }

  void minimizza_swappando(Graph graph) {
    while(swappare) {
      ArrayList urna = new ArrayList(graph.numNodes());
      ArrayList posizioni = new ArrayList(graph.numNodes());
      for (int i=0; i<graph.numNodes(); i++) {
        Integer pos = new Integer(i);
        urna.add(pos);
      }
      for (int i=0; i<graph.numNodes(); i++) {
        int j=random.nextInt(urna.size());
        posizioni.add((Integer)urna.get(j));
        urna.remove(j);
      }
      boolean scambio=false;
      double energia_prima=0;
      double energia_dopo=0;
      for (int i=0; i<posizioni.size()&&swappare; i++) {
        for (int j=0; j<i&&swappare; j++) {
          int indice_i = ((Integer)posizioni.get(i)).intValue();
          int indice_j = ((Integer)posizioni.get(j)).intValue();
          energia_prima = energy(graph);
          int posizione_scambio=graph.node(indice_i).getPosition();
          graph.node(indice_i).setPosition(graph.node(indice_j).getPosition());
          graph.node(indice_j).setPosition(posizione_scambio);
          energia_dopo = energy(graph);
          if (energia_prima-energia_dopo>Kgaussian*random.nextGaussian() ) {
            scambio=true;
          } else {
            graph.node(indice_j).setPosition(graph.node(indice_i).getPosition());
            graph.node(indice_i).setPosition(posizione_scambio);
          }
        }
        interfaccia.messaggi.append("\n"+energia_prima);
        interfaccia.label_Energia.setText(""+energia_prima);
      }
    }
  }//end boolean swapEffect(Graph graph)


  void minimizza_a_pennellate(Graph graph) {
    interfaccia.messaggi.append("\n");
    double E= energy(graph);
    double newE;
    int startPoint = 0;
    while (pennellare) {
      String stringE = ""+E;
      interfaccia.messaggi.append("\n"+stringE);
      interfaccia.label_Energia.setText(stringE);
      for (int i=startPoint; i<graph.numNodes()-1+startPoint; i++) {
        graph.swap(graph.node(graph.nodeIndexByPosition(i))
                  ,graph.node(graph.nodeIndexByPosition(i+1)));
        newE= energy(graph);
        if (newE-E>Kgaussian*random.nextGaussian()) {
          graph.swap(graph.node(graph.nodeIndexByPosition(i))
                    ,graph.node(graph.nodeIndexByPosition(i+1)));
          newE=E;
        }
        E=newE;
      }
      for (int i=startPoint; i>startPoint-graph.numNodes()+1; i--) {
        graph.swap(graph.node(graph.nodeIndexByPosition(i))
                  ,graph.node(graph.nodeIndexByPosition(i+1)));
        newE= energy(graph);
        if (newE-E>Kgaussian*random.nextGaussian()) {
          graph.swap(graph.node(graph.nodeIndexByPosition(i))
                    ,graph.node(graph.nodeIndexByPosition(i+1)));
          newE=E;
        }
        E=newE;
      }
    }
  }

  void minimizza_a_pennellate_fast(Graph graph) {
    int startPoint = 0;
    while (pennellare_fast) {
      for (int i=startPoint; i<graph.numNodes()-1+startPoint; i++) {
        int indiceSX = graph.nodeIndexByPosition(i);
        int indiceDX = graph.nodeIndexByPosition(i+1);
        long deltaForce = force(indiceSX, graph)-force(indiceDX, graph);
        if (deltaForce>Kgaussian*random.nextGaussian()) {
          graph.swap(graph.node(indiceSX)
                    ,graph.node(indiceDX) );
        }
      }
      for (int i=startPoint; i>startPoint-graph.numNodes()+1; i--) {
        int indiceSX = graph.nodeIndexByPosition(i);
        int indiceDX = graph.nodeIndexByPosition(i+1);
        long deltaForce = force(indiceSX, graph)-force(indiceDX, graph);
        if (deltaForce>Kgaussian*random.nextGaussian()) {
          graph.swap(graph.node(indiceSX)
                    ,graph.node(indiceDX) );
        }
      }
      double E= energy(graph);
      String stringE =""+E;
      interfaccia.messaggi.append("\n"+stringE);
      interfaccia.label_Energia.setText(stringE);
    }
  }
}