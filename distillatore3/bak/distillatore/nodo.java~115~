  public ArrayList collegamentoArrayList(String interfaccia) {
    ArrayList risultato = new ArrayList();
    collegamentoIP collegamentoCorrente;
    for (int i = 0; i < collegamenti.size(); i++) {
      collegamentoCorrente = (collegamentoIP) collegamenti.get(i);
      if (collegamentoCorrente.interfaccia.compareTo(interfaccia) == 0) {
        risultato.add(collegamentoCorrente);
