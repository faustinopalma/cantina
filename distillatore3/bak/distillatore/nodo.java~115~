    interfaccie.add(new_interfaccia);
  }

  public Interfaccia interfaccia(int i) {
    return (Interfaccia) interfaccie.get(i);
  }

  public Interfaccia interfaccia(String name) {
    int i = 0;
    boolean trovata = false;
    while (!trovata && i < interfaccie.size()) {
      trovata = interfaccia(i).interfaceName.compareTo(name) == 0;
      //System.out.println(interfaccia(i).interfaceName+"  "+name);
      i++;
    }
    i--;
    if (trovata) {
      return (Interfaccia) interfaccie.get(i);
    }
    else {
      return null;
    }
  }

  public void completaEncapsulation() {
    for (int i=0; i< interfaccie.size(); i++) {
