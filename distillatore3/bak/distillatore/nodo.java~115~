      if (collegamento(i).encapsulation.compareTo("") == 0 &&
          (point = collegamento(i).interfaccia.indexOf(".")) != -1) {
        collegamento(i).encapsulation = interfaccia(collegamento(i).interfaccia.
            substring(0, point)).encapsulation;
      }
    }
  }

