  public void setLink() {
    for (int indice = 0; indice < nodiSignificativi.size(); indice++) {
      for (int h = 0; h < Nodo(indice).collegamenti.size(); h++) {
        for (int k = 0; k < Nodo(indice).collegamento(h).vicini.size(); k++) {
          if (Nodo(indice).identificativo.compareTo(
              Nodo(indice).collegamento(h).vicino(k).identificativo) > 0) {
            nodo nodoVicino = Nodo(indice).collegamento(h).vicino(k).nodoObject;
            //if (nodiSignificativi.indexOf(nodoVicino)!=-1)
            addLink(Nodo(indice), Nodo(indice).collegamento(h), nodoVicino,
                    Nodo(indice).collegamento(h).vicino(k).collegamentoVicino,
                    distance(Nodo(indice), Nodo(indice).collegamento(h), k));
          }
        }
      }
      for (int h = 0; h < Nodo(indice).collegamentiDial.size(); h++) {
        for (int k = 0; k < Nodo(indice).collegamentoDial(h).vicini.size(); k++) {
          if (Nodo(indice).identificativo.compareTo(
              Nodo(indice).collegamentoDial(h).vicino(k).identificativo) > 0) {
            nodo nodoVicino = Nodo(indice).collegamentoDial(h).vicino(k).
                nodoObject;
            //if (nodiSignificativi.indexOf(nodoVicino)!=-1)
            addLink(Nodo(indice), Nodo(indice).collegamentoDial(h), nodoVicino,
                    Nodo(indice).collegamentoDial(h).vicino(k).
                    collegamentoVicino,
                    distance(Nodo(indice), Nodo(indice).collegamentoDial(h), k));
          }
        }
      }
    }
  }

  public ArrayList orderedLinks = new ArrayList();
