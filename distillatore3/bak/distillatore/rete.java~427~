  public ArrayList Links = new ArrayList();
  private class link {
    nodo source;
    nodo target;
    collegamentoIP link_target;
    collegamentoIP link_source;
    double distance;
  } //end class Links

  void addLink(nodo source, collegamentoIP link_source, nodo target,
               collegamentoIP link_target, double distance) {
    link link = new link();
    link.source = source;
    link.target = target;
    link.distance = distance;
    link.link_source = link_source;
    link.link_target = link_target;
    Links.add(link);
  }

  link link(int indice) {
    try {
      return (link) Links.get(indice);
    } catch (IndexOutOfBoundsException err) {
      return null;
      System.err.println(err);
    }
  }

  link lastLink() {
    return (link) Links.get(Links.size() - 1);
  }

