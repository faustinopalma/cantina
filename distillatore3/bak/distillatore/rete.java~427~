       if (collegamento.tipoLink.compareTo(collegamento.vicino(j).tipoLink) ==
           0) {
         tipoLink = collegamento.tipoLink;
       }
       else {
         tipoLink = collegamento.tipoLink + collegamento.vicino(j).tipoLink;
       }
       long distance;

       if (tipoLink.compareTo("Fas") == 0) {
         distance = 100;
       }
       else if (tipoLink.compareTo("Eth") == 0) {
         distance = 100;
       }
       else if (tipoLink.compareTo("EthFas") == 0) {
         distance = 100;
       }
       else if (tipoLink.compareTo("FasEth") == 0) {
         distance = 100;
       }
       else if (tipoLink.compareTo("Tok") == 0) {
         distance = 100;
       }
       else if (tipoLink.compareTo("BRI") == 0) {
         distance = 100000;
       }
       else if (tipoLink.compareTo("Dia") == 0) {
         distance = 100000;
       }
       else if (tipoLink.compareTo("Tun") == 0) {
         distance = 1000000;
       }
       else {
         distance = 10000;
       }
       return distance;
