  public void aggiungiNodo(nodo nodo) {
    nodo.identificativo = "Router_" + String.valueOf(numeroNodi + 1);
    nodo.riferimento = ".\\Topologia\\" + nodo.identificativo + ".html";
    for (int i = 0; i < nodo.collegamenti.size(); i++) {
      boolean pseudoNodoPresente = false;
      for (int j = 0; j < numeroPseudoNodi; j++) {
        boolean corrisponde = nodo.collegamento(i).confrontaCollegamenti(
            pseudoNodo(j).collegamento(0)) &&
            nodo.collegamento(i).verificaMask(pseudoNodo(j).collegamento(0));
        if (corrisponde) {
          pseudoNodoPresente = true;
        }
      }
      if (!pseudoNodoPresente) {
        nodo newPseudoNodo = new nodo("Network_" +
                                      String.valueOf(numeroPseudoNodi + 1),
                                      messaggi);
        newPseudoNodo.identificativo = "Network_" +
            String.valueOf(numeroPseudoNodi + 1);
        newPseudoNodo.riferimento = ".\\Topologia\\" +
            newPseudoNodo.identificativo + ".html";
        newPseudoNodo.aggiungiCollegamento("rete",
                                           nodo.collegamento(i).indirizzo(),
                                           nodo.collegamento(i).mask());
        newPseudoNodo.collegamento(0).tipoLink = nodo.collegamento(i).tipoLink;
        newPseudoNodo.collegamento(0).indirizzo.and(newPseudoNodo.collegamento(
            0).mask);
        boolean maggioreTrovato = false;
        int posizioneInserimento = 0;
        while (!maggioreTrovato && (posizioneInserimento < numeroPseudoNodi)) {
          collegamentoIP daConfrontare = ( (nodo) pseudoNodi.get(
              posizioneInserimento)).collegamento(0);
          maggioreTrovato = newPseudoNodo.collegamento(0).minore(daConfrontare);
          posizioneInserimento++;
        }
//      corregge il nome dello PseudoNodo
        newPseudoNodo.nome = newPseudoNodo.collegamento(0).indirizzo() +
            newPseudoNodo.collegamento(0).barraMask();
        if (maggioreTrovato) {
          pseudoNodi.add(posizioneInserimento - 1, newPseudoNodo);
        }
        else {
          pseudoNodi.add(newPseudoNodo);
        }
        nodiSignificativi.add(newPseudoNodo);
        numeroPseudoNodi = pseudoNodi.size();
      }
    }
    nodo.indiceNodo = numeroNodi;
    for (int i = 0; i < numeroPseudoNodi; i++) {
      collegaNodi(nodo, pseudoNodo(i));
    }
    nodi.add(nodo);
    nodiSignificativi.add(nodo);
    numeroNodi = nodi.size();
  }

  public void collegaNodi(nodo nodoUno, nodo nodoDue) {
    for (int i = 0; i < nodoUno.collegamenti.size(); i++) {
      for (int j = 0; j < nodoDue.collegamenti.size(); j++) {
        boolean collegatiIP = nodoUno.collegamento(i).confrontaCollegamenti(
            nodoDue.collegamento(j))
            ||
            nodoDue.collegamento(j).confrontaCollegamenti(nodoUno.
            collegamento(i));
        boolean maskDiversa = !nodoUno.collegamento(i).verificaMask(nodoDue.
            collegamento(j));
        boolean notShutDown = true;
        if (nodoUno.collegamento(i).shutdown != null) {
          notShutDown = notShutDown &&
              nodoUno.collegamento(i).shutdown.indexOf("shutdown") == -1;
        }
        if (nodoDue.collegamento(j).shutdown != null) {
          notShutDown = notShutDown &&
              nodoDue.collegamento(j).shutdown.indexOf("shutdown") == -1;
        }
        if (collegatiIP && notShutDown) {
          nodoUno.collegamento(i).aggiungiVicino(nodoDue,
                                                 nodoDue.collegamento(j),
                                                 nodoDue.nome,
                                                 nodoDue.collegamento(j).
                                                 indirizzo(),
                                                 nodoDue.identificativo,
                                                 nodoDue.indiceNodo, j,
                                                 maskDiversa,
                                                 nodoDue.collegamento(j).
                                                 tipoLink);
          nodoDue.collegamento(j).aggiungiVicino(nodoUno,
                                                 nodoUno.collegamento(i),
                                                 nodoUno.nome,
                                                 nodoUno.collegamento(i).
                                                 indirizzo(),
                                                 nodoUno.identificativo,
                                                 nodoUno.indiceNodo, i,
                                                 maskDiversa,
                                                 nodoUno.collegamento(i).
                                                 tipoLink);
          nodoUno.collegamento(i).ultimo_vicino().riflesso = nodoDue.
              collegamento(j).ultimo_vicino();
          nodoDue.collegamento(j).ultimo_vicino().riflesso = nodoUno.
              collegamento(i).ultimo_vicino();
        }
      }
    }
  }

  public void collegaTuttiDialer() {
    for (int i = 0; i < nodi.size() - 1; i++) {
      for (int j = i + 1; j < nodi.size(); j++) {
