  void orderLinks() {
    if (link(0).source.centrality > link(0).target.centrality) {
      nodo tempLink = link(0).source;
      link(0).source = link(0).target;
      link(0).target = tempLink;
      collegamentoIP link_temp = link(0).link_source;
      link(0).link_source = link(0).link_target;
      link(0).link_target = link_temp;
    }
    orderedLinks.clear();
    orderedLinks.add(link(0));
    for (int i = 1; i < Links.size(); i++) {
      if (link(i).source.centrality > link(i).target.centrality) {
        nodo tempLink = link(i).source;
        link(i).source = link(i).target;
        link(i).target = tempLink;
        collegamentoIP link_temp = link(i).link_source;
        link(i).link_source = link(i).link_target;
        link(i).link_target = link_temp;
      }
      boolean classificato = false;
      int indice_inferiore = 0;
      int indice_superiore = orderedLinks.size();
      int indice_medio = (indice_superiore + indice_inferiore) / 2;
      while (!classificato) {
        if (indice_superiore - indice_inferiore <= 1) {
          if (link(i).source.centrality <
              orderedLink(indice_inferiore).source.centrality) {
            orderedLinks.add(indice_inferiore, link(i));
            classificato = true;
          }
          else {
            orderedLinks.add(indice_superiore, link(i));
            classificato = true;
          }
        }
        else {
          indice_medio = (indice_superiore + indice_inferiore) / 2;
          if (link(i).source.centrality <
              orderedLink(indice_medio).source.centrality) {
            indice_superiore = indice_medio;
          }
          else {
            indice_inferiore = indice_medio;
          }
        }
      } //end while (!classificato)
    } //end (int i=0; i<Nodes.size(); i++)
  }

