  public nodo generaNodo() {
    String HostName = scriviHostNameDaShVer();
    nodo nodo = new nodo(HostName, messaggi);
    nodo.grappa.CommunitySNMP = scriviCommunity();
    nodo.grappa.Flash = scriviFlash();
    nodo.grappa.LoopBackGestione = scriviIndirizzoLoopBack();
    nodo.grappa.IOS = scriviVersioneIOS();
    nodo.grappa.RAM = scriviRAMShared();
    nodo.grappa.SerialNumber = scriviSerialNumber();
    nodo.grappa.Modello = scriviModelloRouter();
    boolean flagBackUp = false;
    for (int i = 0; i < interfacce.length; i++) {
      distillatore distillaInterfaccia = new distillatore(interfacce[i],
          messaggi);
      String shutdown = distillaInterfaccia.trovaPrendiParola("\n *shutdown", 0);
      String interfaccia = distillaInterfaccia.trovaPrendiRiga("\n *interface");
      boolean subinterface= false;
      String interfaceMother=null;
      if (interfaccia.indexOf(".")!=-1) {
        subinterface=true;
        interfaceMother=interfaccia(interfaccia.substring(0, interfaccia.indexOf(".")));
      }
      String encapsulation = distillaInterfaccia.trovaPrendiParola(
          "\n *encapsulation", 2);
      nodo.addInterfaccia(interfaccia, encapsulation);
      boolean InterfaceShutted = shutdown.indexOf("shutdown") != -1;
      if (subinterface) {
        InterfaceShutted=InterfaceShutted || interfaceMother.indexOf("shutdown")!=-1;
      }
      if (!InterfaceShutted) {
        String[] ip_address = distillaInterfaccia.separaBlocchiRipetuti(
            "\n *ip address", ".\n");
        boolean dial = false;
        if (interfaccia.indexOf("Serial") != -1) {
          dial = interfaccia.indexOf(":15") != -1;
          dial = dial && distillaInterfaccia.verificaParolaBool("\n *dialer ");
        }
        if (!dial) {
          dial = interfaccia.indexOf("Dialer") != -1;
        }
        if (!dial) {
          dial = interfaccia.indexOf("BRI") != -1;
        }
        if (dial) {
          flagBackUp = true;
        }
        if (ip_address != null) {
          for (int j = 0; j < ip_address.length; j++) {
            distillatore distilla_ip_address = new distillatore(ip_address[j],
                messaggi);
            String indirizzo = distilla_ip_address.trovaPrendiParola(
                "\n *ip address", 2);
            String mask = distilla_ip_address.trovaPrendiParola(
                "\n *ip address [0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}",
                2);
            nodo.aggiungiCollegamento(interfaccia, indirizzo, mask);
            collegamentoIP collegamento = nodo.collegamento(nodo.collegamenti.
                size() - 1);
            collegamento.tipoLink = interfaccia.substring(1, 4);
            collegamento.encapsulation = encapsulation;
            collegamento.bandwidth = distillaInterfaccia.trovaPrendiParola(
                "\n *bandwidth", 2);
            collegamento.shutdown = shutdown;
            if (distillaInterfaccia.verificaParolaBool("description")) {
              collegamento.descrizione = distillaInterfaccia.trovaPrendiRiga(
                  "description");
//------Grappa------------------------------------------------------------------
            }
            collegamento.grappa.DLCI = scriviDLCI(interfacce[i]);
            String VPI_VCI = scrivi_VPI_VCI(interfacce[i]);
            if (VPI_VCI.indexOf("/") != -1) {
              collegamento.grappa.VPI = VPI_VCI.substring(0,
                  VPI_VCI.indexOf("/"));
              collegamento.grappa.VCI = VPI_VCI.substring(VPI_VCI.indexOf("/") +
                  1);
            }
//------Grappa------------------------------------------------------------------
          }
        }
      }
    }
    if (flagBackUp) {
      nodo.grappa.flagBackUp = "SI";
    }
    else {
      nodo.grappa.flagBackUp = "NO";
    }
    nodo.completaEncapsulation();
    return nodo;
  }

