  esecutore(String testoPath, tabella tabellaOutput, TextArea messaggi) {
    ApriSepara showSeparati = new ApriSepara(testoPath, messaggi);
    shRun = showSeparati.getIniziaFinisceCon("#sho?w? runn?i?n?g?\\n",
                                             "\\nend\\n");
    shLogging = showSeparati.getIniziaFinisceCon("#sh logging", "#show");
    if (shLogging != null) {
      distillaShLogging = new distillatore(shLogging, messaggi);
    }
    if (shRun == null) {
      shRun = showSeparati.getIniziaFinisceCon("---- show running-config ----",
                                               "--- show ");
    }
    shVer = showSeparati.getIniziaFinisceCon("--- show version", "--- show ");
    verificaShDiag = (showSeparati.getTesto().indexOf("--- show diag") != -1);
    if (verificaShDiag) {
      shDiag = showSeparati.getIniziaFinisceCon("--- show diag", "--- show ");
    }
    shController = showSeparati.getIniziaFinisceCon("--- show controllers",
        "--- show ");
    intestazione = showSeparati.getIniziaFinisceCon("= inizio intestazione =",
        "= fine intestazione =");

    distillaShRun = new distillatore(shRun, messaggi);
    distillaShVer = new distillatore(shVer, messaggi);
    if (verificaShDiag) {
      distillaShDiag = new distillatore(shDiag, messaggi);
    }
    distillaShController = new distillatore(shController, messaggi);
    distillaIntestazione = new distillatore(intestazione, messaggi);

    interfacce = distillaShRun.separaBlocchiRipetuti("\\ninterface", "\\n!\\n");
    shInterface = showSeparati.getIniziaFinisceCon("--- show interfaces ---",
        "--- show");
    distillaShInterface = new distillatore(shInterface, messaggi);
    interfacceSh = distillaShInterface.separaBlocchiRipetuti(
        "\n {0,1}[a-zA-Z]+[0-9/\\.:]+");
  }

