  public String scriviRAMShared() {
    try {
      String RAMShared = "";
      String RAM = "";
      String Shared = "";
      String rigaRAMShared = distillaShVer.trovaPrendiRiga(
          "cisco.{0,100}processor");
      distillatore distillaRAMShared_2 = new distillatore(rigaRAMShared,
          messaggi);
      String tempRAMShared = distillaRAMShared_2.trovaPrendiParola("with", 2);
      tempRAMShared = tempRAMShared.replaceAll("[kK]", "");
      // calcolo degli estremi delle sottostringhe
      int startRAM = 0;
      int endRAM = tempRAMShared.indexOf("/");
      int startShared = tempRAMShared.indexOf("/") + 1;
      int endShared = tempRAMShared.length();
      //estrazione delle sottostringhe
      String tempRAM = tempRAMShared.substring(startRAM, endRAM);
      String tempShared = tempRAMShared.substring(startShared, endShared);
      // conversione a valori interi e passaggio a MB
      Integer integerRAM = new Integer(tempRAM);
      Integer integerShared = new Integer(tempShared);
      int numRAM = integerRAM.intValue() / 1024;
      int numShared = integerShared.intValue() / 1024;
      // ritorno a stringa
      RAM = RAM.valueOf(numRAM);
      Shared = RAM.valueOf(numShared);
      // deduzione stringa finale
      RAMShared = RAM + "/" + Shared + " MB";
      return RAMShared;
    }
    catch (StringIndexOutOfBoundsException e) {
      return "";
    }
  }

  public String scriviFlash() {
    //estrapola la Flash anche quando è composta da piu' di una voce
    //inoltre somma le voci e converte in MB
    String[] flashVettore = distillaShVer.separaBlocchiRipetuti(
        "[0-9]{1,10}[kK] bytes of processor board System flash", "\\n");
    String flash = "";
    int numFlash = 0;
    int intFlash;
    try {
      for (int i = 0; i < flashVettore.length; i++) {
        distillatore unaFlash = new distillatore(flashVettore[i], messaggi);
        String strFlash1 = unaFlash.trovaPrendiParola("bytes", -7);
        String strFlash = strFlash1.replaceAll("[kK]", "");
        Integer integerFlash = new Integer(strFlash);
        numFlash = numFlash + integerFlash.intValue();
      }
      flash = flash.valueOf(numFlash / 1024) + " MB";
    }
    catch (NullPointerException e) {}
    return flash;
  }

  public String scriviSerialNumber() {
