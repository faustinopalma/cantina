    public String interfaccia(String interfaccia) {
      String risultato = null;
      boolean trovata = false;
      int indice = 0;
      while (indice < interfacce.length && !trovata) {
        distillatore distillaInterfaccia = new distillatore(interfacce[indice],
            messaggi);
        String nome_interfaccia = distillaInterfaccia.trovaPrendiRiga("\n *interface");
        if (interfaccia.compareTo(nome_interfaccia)==0) {
          risultato=interfacce[indice];
          trovata=true;
        }
        indice++;
      }
      return risultato;
    }

