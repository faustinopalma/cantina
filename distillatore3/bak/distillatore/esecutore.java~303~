  public nodo generaAlberoTrivial(String nome) {
    nodo albero = new nodo(nome, messaggi);
    String modelloRouter = scriviModelloRouter();
    albero.aggiungiVariabile("modello", modelloRouter);
    String[] slotSeparati = separaSlotShDiag();
    if (slotSeparati != null) {
      for (int i = 0; i < slotSeparati.length; i++) {
        albero.aggiungiRamo("Slot: " + String.valueOf(i));
        distillatore distillaSlot = new distillatore(slotSeparati[i], messaggi);
        ArrayList listaPartNumber =
            distillaSlot.trovaPrendiProssimoNumeroMultiplo("Part number");
        for (int j = 0; j < listaPartNumber.size(); j++) {
          String partNumber = (String) listaPartNumber.get(j);
          partNumber = partNumber.substring(0, partNumber.lastIndexOf("-"));
          albero.ramo(i).aggiungiVariabile("Part number", partNumber);
        }
      }
    }
    else { //if (slotSeparati != null)
      ArrayList interfacce = distillaShVer.TrovaPrendiContenutoFra("[0-9]+",
