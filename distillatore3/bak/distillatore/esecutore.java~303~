            for (int j = 0; j < ip_address.length; j++) {
              distillatore distilla_ip_address = new distillatore(ip_address[j],
                  messaggi);
              String indirizzo = distilla_ip_address.trovaPrendiParola(
                  "\n *ip address", 2);
              String mask = distilla_ip_address.trovaPrendiParola(
                  "\n *ip address [0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}",
                  2);
              nodo.aggiungiCollegamentoDial(interfaccia, indirizzo, mask);
              collegamentoIP collegamento = nodo.collegamentoDial(nodo.
                  collegamentiDial.size() - 1);
              collegamento.tipoLink = interfaccia.substring(1, 4);
              collegamento.encapsulation = encapsulation;
              collegamento.bandwidth = distillaInterfaccia.trovaPrendiParola(
                  "\n *bandwidth", 2);
              collegamento.shutdown = shutdown;
              if (distillaInterfaccia.verificaParolaBool("description")) {
                collegamento.descrizione = distillaInterfaccia.trovaPrendiRiga(
                    "description");
              }
              if (comandiISDN != null) {
                collegamento.count_dial_num = comandiISDN.length;
                for (int h = 0; h < comandiISDN.length; h++) {
                  distillatore distillaComandoISDN = new distillatore(
                      comandiISDN[
                      h], messaggi);
                  String[] dialer_string = distillaComandoISDN.
                      trovaPrendiRegularExp("[0-9]{4,}$");
                  if (dialer_string != null) {
                    collegamentoIP collegamentoVicino = new collegamentoIP(
                        "0.0.0.0", "0.0.0.0", messaggi);
                    collegamento.aggiungiVicino(new nodo("Nome?", messaggi),
                                                collegamentoVicino, "Nome?",
                                                "IPaddress?", "identificativo?",
                                                -1, -1, false, "Dial");
                    collegamento.vicino(collegamento.vicini.size() - 1).
                        dialer_number = dialer_string[0];
                    if (distillaComandoISDN.verificaParolaBool("dialer map")) {
                      String[] address = distillaComandoISDN.
                          trovaPrendiRegularExp(
                          "[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}");
                      dialer_map_number.add(dialer_string[0]);
                      dialer_map_address.add(address[0]);
                    }
                  }
                }
              }
            }
          }
        }
        else {
          if (ip_address != null) {
            for (int j = 0; j < ip_address.length; j++) {
              distillatore distilla_ip_address = new distillatore(ip_address[j],
                  messaggi);
              String indirizzo = distilla_ip_address.trovaPrendiParola(
                  "\n *ip address", 2);
              String mask = distilla_ip_address.trovaPrendiParola(
                  "\n *ip address [0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}",
                  2);
              nodo.aggiungiCollegamento(interfaccia, indirizzo, mask);
              collegamentoIP collegamento = nodo.collegamento(nodo.collegamenti.
                  size() - 1);
              collegamento.tipoLink = interfaccia.substring(1, 4);
              collegamento.encapsulation = distillaInterfaccia.
                  trovaPrendiParola(
                  "\n *encapsulation", 2);
              collegamento.bandwidth = distillaInterfaccia.trovaPrendiParola(
                  "\n *bandwidth", 2);
              collegamento.shutdown = shutdown;
              if (distillaInterfaccia.verificaParolaBool("description")) {
                collegamento.descrizione = distillaInterfaccia.trovaPrendiRiga(
                    "description");
                //------Grappa----------------------------------------------------------------
              }
              collegamento.grappa.DLCI = scriviDLCI(interfacce[i]);
              String VPI_VCI = scrivi_VPI_VCI(interfacce[i]);
              if (VPI_VCI.indexOf("/") != -1) {
                collegamento.grappa.VPI = VPI_VCI.substring(0,
                    VPI_VCI.indexOf("/"));
                collegamento.grappa.VCI = VPI_VCI.substring(VPI_VCI.indexOf("/") +
                    1);
              }
              //------Grappa----------------------------------------------------------------
            }
          }
        }
      }
    }
    if (nodo.collegamentiDial.size() > 0 && nodo.collegamenti.size() > 0) {
      nodo.grappa.flagBackUp = "SI";
    }
    else {
      nodo.grappa.flagBackUp = "NO";
    }
    nodo.completaEncapsulation();
    return nodo;
  }


  public void popola_numeri_dial(foresta foresta_numeri_dial,
                                 String id_collegamento, String hostName) {
    for (int i = 0; i < interfacce.length; i++) {
      distillatore distillaInterfaccia = new distillatore(interfacce[i],
          messaggi);
      String[] comandiISDN = distillaInterfaccia.separaBlocchiRipetuti(
          "(\n *dialer string)|(\n *dialer map)", ".\n");
      if (comandiISDN != null) {
        for (int h = 0; h < comandiISDN.length; h++) {
          distillatore distillaComandoISDN = new distillatore(comandiISDN[h],
              messaggi);
          String[] dialer_string = distillaComandoISDN.trovaPrendiRegularExp(
              "[0-9]{4,}$");
          nodo pianta_numero_dial = new nodo("dial_number", messaggi);
          if (dialer_string != null) {
            pianta_numero_dial.aggiungiVariabile("numero", dialer_string[0]);
          }
          foresta_numeri_dial.aggiungiPianta(pianta_numero_dial,
                                             id_collegamento, hostName);
        }
      }
    }
  }

